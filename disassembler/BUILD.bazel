load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "disassembler",
    srcs = glob([
        "src/**",
    ]),
    hdrs = glob([
        "include/**/*.h",
    ]),
    strip_include_prefix = "include/",
    visibility = ["//visibility:public"],
    deps = [
        "//core",
        "@fmt",
    ],
)

cc_test(
    name = "disassembler_test",
    size = "small",
    srcs = glob([
        "test/src/*.cpp",
    ]),
    deps = [
        ":disassembler",
        "//core",
        "//core:core_test_utils",
        "@googletest//:gtest",
    ],
)
